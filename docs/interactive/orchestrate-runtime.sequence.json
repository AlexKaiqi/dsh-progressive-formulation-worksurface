    { "from": 680, "to": 825, "label": "可靠执行" }
  ],
  "messages": [
    { "id": "replay-events", "from": "events", "to": "orchestrate", "y": 185, "label": "replay Event envelopes", "variant": "emphasis" },
    { "id": "load-when", "from": "definition", "to": "orchestrate", "y": 225, "label": "when + Registration bindings", "variant": "security" },
    { "id": "record-activation", "from": "orchestrate", "to": "operations", "y": 270, "label": "record Activation(key, source EventRefs)", "variant": "emphasis" },
    { "id": "resolve-inputs", "from": "orchestrate", "to": "resolver", "y": 340, "label": "Activation + code.env bindings", "variant": "security" },
    { "id": "read-sources", "from": "resolver", "to": "events", "y": 385, "label": "read exact source EventRefs" },
    { "id": "source-events", "from": "events", "to": "resolver", "y": 425, "label": "Event envelopes", "variant": "return" },
    { "id": "event-contracts", "from": "definition", "to": "resolver", "y": 470, "label": "Event Contracts + formats", "variant": "security" },
    { "id": "start-code", "from": "resolver", "to": "code", "y": 555, "label": "start with TASK_ID / QUESTION / WS_*", "variant": "emphasis", "note": "Runtime 已完成事件选择、pointer 取值、类型校验和序列化。" },
    { "id": "code-output", "from": "code", "to": "gate", "y": 610, "label": "exit 0 + WS_EFFECTS_FILE JSONL", "variant": "emphasis" },
    { "id": "effect-contracts", "from": "definition", "to": "gate", "y": 650, "label": "effect capabilities + payload Schemas", "variant": "security" },
    { "id": "open-operation", "from": "gate", "to": "operations", "y": 715, "label": "create/resume (ActivationId, operationKey)", "variant": "security" },
    { "id": "execute-effect", "from": "operations", "to": "target", "y": 760, "label": "emit Event or deliver followup", "variant": "emphasis" },
    { "id": "stable-result", "from": "target", "to": "operations", "y": 798, "label": "stable EventId / MessageId", "variant": "return" },
    { "id": "settle", "from": "operations", "to": "orchestrate", "y": 830, "label": "settle Activation", "variant": "return" }
  ],
  "activations": [
    { "participant": "orchestrate", "from": 180, "to": 835, "type": "backend" },
    { "participant": "resolver", "from": 335, "to": 560, "type": "security" },
    { "participant": "code", "from": 550, "to": 615, "type": "frontend" },
    { "participant": "gate", "from": 605, "to": 720, "type": "security" },
    { "participant": "operations", "from": 265, "to": 835, "type": "database" },
    { "participant": "target", "from": 755, "to": 805, "type": "external" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "进程启动之前",
      "items": [
        "Runtime 只读取 Activation 已选中的 source EventRefs",
        "必需值缺失、类型错误或大小超限：不启动 code，不产生 Operation",
        "大值按 binding 定点物化；不会把完整上下文丢给 code 检索"
      ]
    },
    {
      "dot": "rose",
      "title": "进程退出之后",
      "items": [
        "先校验完整 effect batch，再产生任何外部效果",
        "非零退出、超时、非法 effect 或重复 operationKey：整批无效果",
        "Operation 先记录再执行，重启后用稳定身份恢复"
      ]
    }
  ]
}
