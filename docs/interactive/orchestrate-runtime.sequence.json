  },
  "participants": [
    { "id": "events", "type": "messagebus", "label": "Event Stream", "sublabel": "Surface facts" },
    { "id": "definition", "type": "database", "label": "Definition", "sublabel": "fixed revision" },
    { "id": "orchestrate", "type": "backend", "label": "Orchestrate", "sublabel": "replay + match" },
    { "id": "resolver", "type": "security", "label": "Input Resolver", "sublabel": "select + pointer" },
    { "id": "code", "type": "frontend", "label": "Code Process", "sublabel": "direct env" },
    { "id": "gate", "type": "security", "label": "Effect Gate", "sublabel": "batch validation" },
    { "id": "operations", "type": "database", "label": "Operation Store", "sublabel": "record + settle" },
