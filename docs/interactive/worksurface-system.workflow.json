{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "WorkSurface：Surface、Episode 与事件驱动推进",
    "locale": "zh-CN",
    "output": "worksurface-system.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden",
      "entries": {
        "cloud": { "label": "Surface" },
        "messagebus": { "label": "Event" },
        "external": { "label": "Orchestrate Source" },
        "backend": { "label": "Episode" },
        "database": { "label": "Definition IR" },
        "security": { "label": "Orchestrate" },
        "frontend": { "label": "WorkSurface Runtime" }
      }
    },
    "viewBox": [900, 466],
    "views": [
      {
        "id": "core-model",
        "label": "主模型",
        "focus": ["surface", "episode", "surface-next"],
        "note": "Surface 持续存在；每次有边界的推进沉淀为一个 Episode，多个 Episode 依次推进同一 Surface。"
      },
      {
        "id": "episode-content",
        "label": "Episode 内容",
        "focus": ["episode", "custom-event", "surface-next"],
        "note": "Episode 包含或引用模型步骤、工具调用、Surface 修改与结果；推进中可产生自定义 Event，并形成同一 Surface 的新状态。"
      },
      {
        "id": "compile-boundary",
        "label": "编译边界",
        "focus": ["orchestrate-source", "definition-ir", "orchestrate-instance"],
        "note": "YAML 与 Code 都是作者源码；compile / adapt 后形成同一种不可变 Definition IR，再与实际 Surface 装配成 Instance。"
      },
      {
        "id": "event-driven-control",
        "label": "事件驱动推进",
        "focus": ["definition-ir", "orchestrate-instance", "custom-event", "orchestrate", "runtime"],
        "note": "推进控制层只消费 Definition IR、Instance 与 Event，产生统一 Effect；它不知道源码来自 YAML 还是 Code。"
      },
      {
        "id": "execution-boundary",
        "label": "执行承载边界",
        "focus": ["episode", "orchestrate", "runtime"],
        "note": "推进控制器通过 adapter 调用目标 Surface 绑定的 DSH Session；Session 不承载 Orchestrate 自身。"
      }
    ]
  },
  "lanes": [
    { "id": "surface-advance", "label": "Surface / Episode：持续推进" },
    { "id": "orchestrate-authoring", "label": "Orchestrate：源码 → Definition IR → Instance" },
    { "id": "progress-control", "label": "事件求值与推进控制" }
  ],
  "phases": [
    { "id": "author", "label": "作者输入", "fromCol": 0, "toCol": 1 },
    { "id": "normalize", "label": "推进与规范化", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "evaluate", "label": "装配、求值与继续", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "episode-scope", "label": "一次 Episode", "lane": "surface-advance", "fromCol": 2, "toCol": 5, "variant": "emphasis" },
    { "id": "compile-boundary", "label": "统一编译 / 适配边界", "lane": "orchestrate-authoring", "fromCol": 0, "toCol": 4, "variant": "emphasis" },
    { "id": "event-control", "label": "统一 evaluator contract", "lane": "progress-control", "fromCol": 2, "toCol": 5, "variant": "emphasis" }
  ],
  "mainPath": ["surface", "episode", "surface-next"],
  "nodes": [
    { "id": "surface", "lane": "surface-advance", "col": 0, "type": "cloud", "label": "当前 Surface", "sublabel": "可寻址、持续维护", "tag": "工作上下文" },
    { "id": "episode", "lane": "surface-advance", "col": 2, "type": "backend", "label": "Episode", "sublabel": "一次有边界的推进", "tag": "步骤 / 工具 / 修改" },
    { "id": "surface-next", "lane": "surface-advance", "col": 5, "type": "cloud", "label": "新的可见状态", "sublabel": "仍是同一个 Surface", "tag": "继续下一 Episode" },
    { "id": "orchestrate-source", "lane": "orchestrate-authoring", "col": 0, "type": "external", "label": "YAML / Code", "sublabel": "Orchestrate Source", "tag": "作者源码" },
    { "id": "definition-ir", "lane": "orchestrate-authoring", "col": 2, "type": "database", "label": "Definition IR", "sublabel": "不可变运行定义", "tag": "统一实现边界" },
    { "id": "orchestrate-instance", "lane": "orchestrate-authoring", "col": 4, "type": "security", "label": "Instance", "sublabel": "DefinitionRef + roles", "tag": "装配实际 Surface" },
    { "id": "custom-event", "lane": "progress-control", "col": 3, "type": "messagebus", "label": "Event", "width": 42 },
    { "id": "orchestrate", "lane": "progress-control", "col": 4, "type": "security", "label": "求值", "width": 42 },
    { "id": "runtime", "lane": "progress-control", "col": 5, "type": "frontend", "label": "推进控制器", "sublabel": "Runtime（暂名）", "tag": "输出 Effect[]" }
  ],
  "edges": [
    { "id": "surface-opens-episode", "from": "surface", "to": "episode", "label": "开始一次推进", "variant": "emphasis", "role": "main" },
    { "id": "episode-updates-surface", "from": "episode", "to": "surface-next", "label": "修改并沉淀", "variant": "emphasis", "role": "main", "route": "straight" },
    { "id": "episode-emits-event", "from": "episode", "to": "custom-event", "label": "emit", "variant": "emphasis", "role": "async", "fromSide": "bottom", "toSide": "bottom", "via": [[300, 180], [690, 180], [690, 414], [430, 414]] },
    { "id": "source-compiles-definition", "from": "orchestrate-source", "to": "definition-ir", "label": "compile / adapt", "variant": "emphasis", "role": "main" },
    { "id": "definition-binds-instance", "from": "definition-ir", "to": "orchestrate-instance", "label": "bind", "variant": "emphasis", "role": "main" },
    { "id": "instance-configures-orchestrate", "from": "orchestrate-instance", "to": "orchestrate", "variant": "emphasis", "role": "branch" },
    { "id": "event-matches-orchestrate", "from": "custom-event", "to": "orchestrate", "variant": "emphasis", "role": "branch" },
    { "id": "orchestrate-controls-runtime", "from": "orchestrate", "to": "runtime", "label": "Effect[]", "variant": "emphasis", "role": "branch", "labelAt": [550, 329] }
  ],
  "cards": [
    { "dot": "cyan", "title": "Surface / Episode", "items": ["Surface 持续存在、可寻址且可维护", "Episode 组织一次有边界的推进和 Surface 修改", "当前仍由目标 Surface 绑定的 DSH Session 承载实际执行"] },
    { "dot": "emerald", "title": "统一 Definition 边界", "items": ["YAML 与 Code 都只是 Orchestrate Source", "compile / adapt 后统一形成不可变 Definition IR", "Instance 只保存 DefinitionRef、Surface 角色绑定与历史边界"] },
    { "dot": "violet", "title": "统一运行边界", "items": ["求值输入只有 Definition、Instance 与 Event", "无论源码形式，求值结果都只能是标准 Effect[]", "推进控制器和 DSH adapter 不感知 YAML / Code"] }
  ]
}
