{
  "name": "dsh-progressive-formulation-worksurface",
  "version": "0.2.0-rc.1",
  "private": true,
  "description": "File-native, event-driven WorkSurface orchestration",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run bundle --workspaces --if-present",
    "clean": "tsc -b --clean",
    "generate:schema": "node scripts/verify-protocol.mjs",
    "check:generated": "node scripts/verify-protocol.mjs",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -b --pretty false",
    "check": "python3 scripts/check.py"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "@types/node": "^22.20.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  }
}
