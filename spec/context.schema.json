{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worksurface.local/spec/context.schema.json",
  "title": "DSH Surface Session Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "execution", "surface", "capabilities"],
  "properties": {
    "version": { "const": 1 },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputSource", "inputRevision", "expectedHead"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inputSource": { "enum": ["published", "authoring", "revision"] },
        "inputRevision": { "$ref": "#/$defs/revision" },
        "expectedHead": { "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
        "outputRevision": { "$ref": "#/$defs/revision" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emit", "targetSurfaces"],
      "properties": {
        "emit": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "targetSurfaces": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
