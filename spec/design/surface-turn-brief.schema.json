{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worksurface.local/spec/design/surface-turn-brief.schema.json",
  "title": "Surface Turn Brief",
  "$comment": "The exact Runtime-generated task-specific brief persisted at $DSH_WORKSURFACE_VIEW_DIR/turn-brief.json for audit and injected into one Surface model call. It contains semantic decisions and stable locators only, never transport, scope, digest, ledgers, locks, or global history.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "surface", "runtimeView", "instruction", "inputs", "outputs"],
  "properties": {
    "version": { "const": 1 },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "directory", "entryPaths"],
      "properties": {
        "handle": { "const": "$DSH_SURFACE_ID" },
        "directory": { "const": "$DSH_SURFACE_DIR" },
        "entryPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "runtime-authority.schema.json#/$defs/relativePath" }
        }
      }
    },
    "runtimeView": { "const": "$DSH_WORKSURFACE_VIEW_DIR" },
    "instruction": { "type": "string", "minLength": 1 },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary"],
      "properties": {
        "name": { "$ref": "runtime-event-contract.schema.json#/$defs/eventName" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "summary"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "detailPath": { "$ref": "#/$defs/rootedFilePath" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "when", "payloadSummary", "schemaPath", "command"],
        "properties": {
          "name": { "$ref": "runtime-event-contract.schema.json#/$defs/eventName" },
          "when": { "type": "string", "minLength": 1 },
          "payloadSummary": { "type": "string", "minLength": 1 },
          "schemaPath": { "$ref": "#/$defs/viewFilePath" },
          "command": { "$ref": "#/$defs/emitCommand" }
        }
      }
    }
  },
  "$defs": {
    "rootedFilePath": {
      "type": "string",
      "pattern": "^\\$(?:DSH_SURFACE_DIR|DSH_WORKSURFACE_VIEW_DIR)/(?!\\.\\.?(?:/|$))(?!.*\/\\.\\.?(?:/|$))(?!.*\\\\)(?!.*[?#%\\u0000\\r\\n]).+$"
    },
    "viewFilePath": {
      "type": "string",
      "pattern": "^\\$DSH_WORKSURFACE_VIEW_DIR/(?!\\.\\.?(?:/|$))(?!.*\/\\.\\.?(?:/|$))(?!.*\\\\)(?!.*[?#%\\u0000\\r\\n]).+$"
    },
    "emitCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            { "const": "$DSH_WORKSURFACE_CLI" },
            { "const": "emit" },
            { "$ref": "runtime-event-contract.schema.json#/$defs/eventName" },
            { "const": "--payload" },
            { "type": "string", "minLength": 2 }
          ],
          "items": false
        }
      }
    }
  }
}
