{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worksurface.local/spec/design/orchestrate-code-context.schema.json",
  "title": "WorkSurface Orchestrate Code Invocation Context v1",
  "$comment": "Opt-in target fallback content of DSH_CONTEXT_FILE. Ordinary code must use Runtime-resolved direct environment bindings; this full context exists only for advanced cases that cannot be expressed by targeted bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "registration", "activation", "matches", "eventContracts", "capabilities"],
  "properties": {
    "version": { "const": 1 },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definitionRevision", "bindings"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "definitionRevision": { "$ref": "#/$defs/revision" },
        "bindings": { "$ref": "#/$defs/bindings" }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subscriptionId", "key", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subscriptionId": { "$ref": "#/$defs/name" },
        "key": { "type": "string" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
      }
    },
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/match" }
    },
    "eventContracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "event-contract.schema.json" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emit", "followup"],
      "properties": {
        "emit": { "type": "array", "items": { "$ref": "#/$defs/effectCapability" } },
        "followup": { "type": "array", "items": { "$ref": "#/$defs/effectCapability" } }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "seq", "id"],
      "properties": {
        "subject": { "type": "string", "pattern": "^(surface|registration):[^\\s:][^\\s]*$" },
        "seq": { "type": "integer", "minimum": 0 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref"],
      "properties": {
        "role": { "$ref": "#/$defs/name" },
        "ref": { "$ref": "#/$defs/eventRef" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref", "event"],
      "properties": {
        "role": { "$ref": "#/$defs/name" },
        "ref": { "$ref": "#/$defs/eventRef" },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "payload", "causes", "meta", "recordedAt"],
          "properties": {
            "name": { "$ref": "#/$defs/name" },
            "payload": true,
            "causes": { "type": "array", "items": { "$ref": "#/$defs/eventRef" } },
            "meta": { "type": "object" },
            "recordedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "effectCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "events"],
      "properties": {
        "role": { "$ref": "#/$defs/name" },
        "events": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
      }
    }
  }
}
