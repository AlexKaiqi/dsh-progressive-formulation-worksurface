{
  "version": 2,
  "roles": ["coordinator", "researcher"],
  "events": [
    {
      "version": 1,
      "name": "research.requested",
      "description": "Research work is ready to be assigned.",
      "payloadSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "question"],
        "properties": { "taskId": { "type": "string", "minLength": 1 }, "question": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "version": 1,
      "name": "research.completed",
      "description": "The assigned research is complete.",
      "payloadSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "resultFile"],
        "properties": { "taskId": { "type": "string" }, "resultFile": { "type": "string" } }
      }
    }
  ],
  "subscriptions": [
    {
      "id": "delegate-research-code",
      "history": "from-registration",
      "key": "$.payload.taskId",
      "when": { "role": "coordinator", "event": "research.requested" },
      "reaction": {
        "code": {
          "command": "python3",
          "path": "handlers/delegate.py",
          "env": {
            "TASK_ID": { "from": { "kind": "event", "role": "coordinator", "event": "research.requested", "pointer": "/payload/taskId" }, "format": "text" },
            "QUESTION": { "from": { "kind": "event", "role": "coordinator", "event": "research.requested", "pointer": "/payload/question" }, "format": "text" }
          },
          "effects": {
            "followup": [
              { "role": "researcher", "outputs": [{ "event": "research.completed", "required": true }] }
            ]
          }
        }
      }
    }
  ]
}
