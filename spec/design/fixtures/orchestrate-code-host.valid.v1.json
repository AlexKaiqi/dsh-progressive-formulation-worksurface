{
  "version": 1,
  "commands": ["bash", "zsh", "python3", "node"],
  "environment": {
    "standard": {
      "WS_ACTIVATION_ID": { "access": "read", "value": "Activation identity" },
      "WS_ACTIVATION_KEY": { "access": "read", "value": "Decoded business key as text" },
      "WS_REGISTRATION_ID": { "access": "read", "value": "Registration identity" },
      "WS_DEFINITION_REVISION": { "access": "read", "value": "Immutable Definition revision" },
      "WS_SUBSCRIPTION_ID": { "access": "read", "value": "Subscription identity" },
      "WS_EFFECTS_FILE": { "access": "append-jsonl", "schema": "orchestrate-effect.schema.json" }
    },
    "declared": {
      "definitionField": "subscription.reaction.code.env",
      "schema": "orchestrate-code-binding.schema.json",
      "namePattern": "^[A-Z][A-Z0-9_]*$",
      "reservedPrefixes": ["WS_", "DSH_"],
      "resolution": "runtime-before-process-start"
    },
    "fallback": {
      "variable": "DSH_CONTEXT_FILE",
      "availableWhen": "subscription.reaction.code.context=file",
      "schema": "orchestrate-code-context.schema.json",
      "purpose": "advanced-full-context-only"
    }
  },
  "filesystem": { "cwd": "definition-revision-root", "definition": "read-only", "materializedInputs": "read-only-private-files" },
  "io": { "stdin": "closed", "stdout": "logs-only", "stderr": "logs-only", "effects": "jsonl-at-WS_EFFECTS_FILE" },
  "limits": { "timeoutMs": 30000, "maxLogBytes": 1048576, "maxEffectsBytes": 1048576, "maxDirectVariableBytes": 8192, "maxDirectEnvironmentBytes": 65536 },
  "reliability": { "resolveInputsBeforeStart": true, "validateBatchBeforeEffects": true, "operationIdentity": ["activation.id", "effect.operationKey"], "nonZeroExit": "no-effects" }
}
