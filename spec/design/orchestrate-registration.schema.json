{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worksurface.local/spec/design/orchestrate-registration.schema.json",
  "title": "Code-first Orchestrate Registration Source",
  "$comment": "Authoring admission metadata outside the selected artifact root. entrypoint and Contract file paths resolve within that root, whose code, Contracts, and support files are snapshotted by RevisionStore as the immutable Orchestrate Revision. bindings name existing Surfaces and admission rejects two handles bound to the same Surface. consumeFrom routes inputs, emitOn authorizes the orchestrate producer, and surfaceOutputFrom authorizes a surface-session producer; business conditions and information transfer remain ordinary code in entrypoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "registrationId", "entrypoint", "bindings", "events"],
  "properties": {
    "version": { "const": 1 },
    "registrationId": { "$ref": "runtime-authority.schema.json#/$defs/localId" },
    "entrypoint": { "$ref": "runtime-authority.schema.json#/$defs/relativePath" },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "runtime-authority.schema.json#/$defs/localId" },
      "additionalProperties": { "$ref": "runtime-authority.schema.json#/$defs/localId" }
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "runtime-event-contract.schema.json#/$defs/eventName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": { "$ref": "runtime-authority.schema.json#/$defs/relativePath" },
          "builtin": { "const": true },
          "consumeFrom": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "runtime-authority.schema.json#/$defs/localId" }
          },
          "emitOn": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "runtime-authority.schema.json#/$defs/localId" }
          },
          "surfaceOutputFrom": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "runtime-authority.schema.json#/$defs/localId" }
          }
        },
        "allOf": [
          {
            "oneOf": [
              { "required": ["file"], "properties": { "file": true, "builtin": false } },
              { "required": ["builtin"], "properties": { "builtin": { "const": true }, "file": false } }
            ]
          },
          {
            "anyOf": [
              { "required": ["consumeFrom"], "properties": { "consumeFrom": true } },
              { "required": ["emitOn"], "properties": { "emitOn": true } },
              { "required": ["surfaceOutputFrom"], "properties": { "surfaceOutputFrom": true } }
            ]
          }
        ]
      }
    }
  }
}
