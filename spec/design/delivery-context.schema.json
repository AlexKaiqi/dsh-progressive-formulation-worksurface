{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worksurface.local/spec/design/delivery-context.schema.json",
  "title": "WorkSurface Activation Delivery Context v1",
  "$comment": "Target per-followup context. It is immutable per managed Operation and is intended to be composed into the target Turn's DSH_CONTEXT_FILE instead of serializing event data into a prose message.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "registration", "activation", "operation", "instruction", "inputs", "allowedOutputs"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definitionRevision", "targetRole"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "definitionRevision": { "$ref": "#/$defs/revision" },
        "targetRole": { "$ref": "#/$defs/name" }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subscriptionId", "key"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subscriptionId": { "$ref": "#/$defs/name" },
        "key": { "type": "string" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "instruction": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/input" }
    },
    "allowedOutputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/allowedOutput" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "seq", "id"],
      "properties": {
        "subject": { "type": "string", "pattern": "^(surface|registration):[^\\s:][^\\s]*$" },
        "seq": { "type": "integer", "minimum": 0 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref", "event"],
      "properties": {
        "role": { "$ref": "#/$defs/name" },
        "ref": { "$ref": "#/$defs/eventRef" },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "payload"],
          "properties": {
            "name": { "$ref": "#/$defs/name" },
            "payload": true
          }
        }
      }
    },
    "allowedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "required", "description", "payloadSchema"],
      "properties": {
        "event": { "$ref": "#/$defs/name" },
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "payloadSchema": {
          "type": "object",
          "required": ["$schema", "type"],
          "properties": {
            "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
            "type": { "const": "object" }
          }
        }
      }
    }
  }
}
