{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worksurface.local/spec/definition.schema.json",
  "title": "WorkSurface Orchestration Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "roles", "subscriptions"],
  "properties": {
    "version": { "const": 1 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "subscriptions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/subscription" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "event"],
      "properties": {
        "role": { "$ref": "#/$defs/name" },
        "event": { "$ref": "#/$defs/name" },
        "payload": true
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/selector" },
        { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["any"], "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["count"], "properties": { "count": { "type": "object", "additionalProperties": false, "required": ["selector", "operator", "value"], "properties": { "selector": { "$ref": "#/$defs/selector" }, "operator": { "enum": ["eq", "gte", "lte"] }, "value": { "type": "integer", "minimum": 0 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["sequence"], "properties": { "sequence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selector" } } } }
      ]
    },
    "emit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "event", "operationKey", "payload"],
      "properties": {
        "role": { "$ref": "#/$defs/name" },
        "event": { "$ref": "#/$defs/name" },
        "operationKey": { "type": "string", "minLength": 1 },
        "payload": true
      }
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "message", "operationKey"],
      "properties": {
        "role": { "$ref": "#/$defs/name" },
        "message": { "type": "string", "minLength": 1 },
        "operationKey": { "type": "string", "minLength": 1 }
      }
    },
    "reaction": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["emit"], "properties": { "emit": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/emit" } } } },
        { "type": "object", "additionalProperties": false, "required": ["followup"], "properties": { "followup": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/followup" } } } },
        { "type": "object", "additionalProperties": false, "required": ["handler"], "properties": { "handler": { "type": "object", "additionalProperties": false, "required": ["command", "path", "reads", "emits"], "properties": { "command": { "enum": ["bash", "zsh", "python3", "node"] }, "path": { "type": "string", "minLength": 1 }, "args": { "type": "array", "items": { "type": "string" } }, "reads": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }, "emits": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } } } } } }
      ]
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "history", "when", "reaction"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "history": { "enum": ["all", "from-registration"] },
        "key": { "type": "string", "minLength": 1 },
        "when": { "$ref": "#/$defs/condition" },
        "reaction": { "$ref": "#/$defs/reaction" }
      }
    }
  }
}
