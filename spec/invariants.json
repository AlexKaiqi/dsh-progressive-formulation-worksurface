    { "id": "WS-20", "statement": "Surface 在 Agent 启动前完成绑定；模型不能 open 或切换当前 Surface，但活动 Turn 可经 Host 创建独立 Surface 契约、注册精确 Definition，并通过 ws emit 驱动依赖", "enforcedAt": ["binding-admission", "product-session-admission", "planning-capability", "cli-boundary"], "tests": ["packages/cli/tests/help.spec.ts", "packages/dsh/tests/session-adapter.spec.ts", "packages/dsh/tests/session-admission.spec.ts", "packages/dsh/tests/session-admission-agent-loop.spec.ts", "packages/web/tests/web.spec.ts"] },
    { "id": "WS-21", "statement": "Agent 默认只写其唯一 Surface Session worktree；跨 Surface 作者契约只经活动 Turn capability 交给 Host 落盘", "enforcedAt": ["session-shell-context", "planning-capability"], "tests": ["packages/dsh/tests/session-surface.spec.ts"] },
