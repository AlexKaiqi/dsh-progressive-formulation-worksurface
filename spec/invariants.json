    { "id": "WS-10", "statement": "每个 Surface Session 独占一个以 SurfaceId 定位的持久 worktree", "enforcedAt": ["binding-admission", "worktree-materialization"], "tests": ["packages/dsh/tests/session-surface.spec.ts"] },
    { "id": "WS-11", "statement": "执行状态只来自 DSH Session/Turn，不写入 Surface 生命周期", "enforcedAt": ["session-adapter", "surface-event-admission"], "tests": ["packages/dsh/tests/session-adapter.spec.ts", "packages/core/tests/view-projection.spec.ts"] },
