    { "id": "WS-16", "statement": "Activation 由 Registration、Subscription 与业务 key 决定", "enforcedAt": ["activation-derive"], "tests": ["packages/core/tests/definition-v1.spec.ts"] },
    { "id": "WS-17", "statement": "同一 activation/operation/target 最多一个目标事件", "enforcedAt": ["managed-emit"], "tests": ["packages/dsh/tests/engine.spec.ts"] },
