{
  "name": "@pf-worksurface/core",
  "description": "WorkSurface events, orchestration definitions, replay folds, projections, and immutable revision objects",
  "version": "0.2.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexKaiqi/dsh-progressive-formulation-worksurface.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
