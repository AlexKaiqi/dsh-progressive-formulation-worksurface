{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PF WorkSurface model evaluation run",
  "type": "object",
  "required": ["suiteId", "suiteVersion", "executedAt", "model", "results"],
  "properties": {
    "suiteId": { "type": "string" },
    "suiteVersion": { "type": "string" },
    "executedAt": { "type": "string", "format": "date-time" },
    "model": { "type": "string" },
    "environment": { "type": "object" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "trials"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^MODEL-E2E-[0-9]{2}$" },
          "trials": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sessionId", "criteria"],
              "properties": {
                "sessionId": { "type": "string" },
                "criteria": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "status", "evidence"],
                    "properties": {
                      "id": { "type": "string" },
                      "status": { "enum": ["passed", "failed", "blocked"] },
                      "evidence": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "metrics": {
                  "type": "object",
                  "properties": {
                    "steps": { "type": "integer", "minimum": 0 },
                    "toolCalls": { "type": "integer", "minimum": 0 },
                    "recoveries": { "type": "integer", "minimum": 0 },
                    "tokens": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
