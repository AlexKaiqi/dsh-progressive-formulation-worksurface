{
  "name": "@pf-worksurface/dsh",
  "description": "b2f-backed DeepSeek Harness WorkSurface Host, orchestration tool, and structured subagent bridge",
  "version": "0.1.0-rc.6",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexKaiqi/dsh-progressive-formulation-worksurface.git",
    "directory": "packages/dsh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "cordis.patch.yml", "lib/types/**/*.d.ts", "evals"],
  "license": "MIT",
  "scripts": {
    "bundle": "tsdown && npm run eval:check",
    "eval:check": "node evals/validate-suite.mjs",
    "prepack": "tsc -b && tsdown"
  },
  "dsh": {
    "inventory": {
      "summary": {
        "zh": "基于 b2f 提供结构化 WorkSurface、编排工具和子 Agent 协作桥接。",
        "en": "Provides a b2f-backed structured WorkSurface, orchestration tools, and a subagent collaboration bridge."
      },
      "tags": [
        "automation",
        "file",
        "subagent",
        "tool",
        "workspace"
      ],
      "dependencies": [
        "@deepseek-ai/dsh-agent",
        "dsh-block-to-file",
        "@deepseek-ai/dsh-sandbox",
        "@deepseek-ai/dsh-shell-env",
        "@deepseek-ai/dsh-subagent",
        "@deepseek-ai/dsh-subprocess",
        "@deepseek-ai/dsh-system-prompt",
        "@deepseek-ai/dsh-tools"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.1.0-rc.6",
    "@pf-worksurface/cli": "workspace:^",
    "@pf-worksurface/core": "workspace:^",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "dsh-block-to-file": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell-env": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "dsh-block-to-file": "link:../../../dsh-block-to-file",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell-env": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  }
}
