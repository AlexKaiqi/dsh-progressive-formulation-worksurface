{
  "name": "@pf-worksurface/dsh",
  "description": "DSH adapter for file-native, event-driven WorkSurface orchestration",
  "version": "0.2.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexKaiqi/dsh-progressive-formulation-worksurface.git",
    "directory": "packages/dsh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "cordis.patch.yml", "lib/types/**/*.d.ts", "evals"],
  "license": "MIT",
  "scripts": {
    "bundle": "tsdown && npm run eval:check",
    "eval:check": "node evals/validate-suite.mjs",
    "prepack": "tsc -b && tsdown"
  },
  "dsh": {
    "inventory": {
      "summary": {
        "zh": "提供文件化、事件驱动的 WorkSurface、可恢复编排和可追溯发射投影。",
        "en": "Provides file-native, event-driven WorkSurfaces, recoverable orchestration, and traceable emission projections."
      },
      "tags": [
        "automation",
        "events",
        "orchestration"
      ],
      "dependencies": [
        "@deepseek-ai/dsh-session",
        "@deepseek-ai/dsh-session-persistence",
        "@deepseek-ai/dsh-agent-default-model",
        "@deepseek-ai/dsh-subprocess",
        "@deepseek-ai/dsh-shell-env",
        "@deepseek-ai/dsh-system-prompt",
        "@deepseek-ai/dsh-sandbox",
        "@deepseek-ai/dsh-agent"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@pf-worksurface/cli": "workspace:^",
    "@pf-worksurface/core": "workspace:^",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.3 <0.2.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-shell-env": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-alpha.2 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-shell-env": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.2"
  }
}
