{
  "version": 1,
  "roles": ["source", "target"],
  "subscriptions": [
    {
      "id": "javascript-handler",
      "history": "from-registration",
      "key": "$.payload.reviewId",
      "when": {
        "role": "source",
        "event": "review.accepted"
      },
      "reaction": {
        "handler": {
          "command": "node",
          "path": "javascript-handler.mjs",
          "reads": ["source"],
          "emits": ["target"]
        }
      }
    }
  ]
}
