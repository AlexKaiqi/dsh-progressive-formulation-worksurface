{
  "specVersion": "0.2.0",
  "name": "@pf-worksurface/dsh",
  "pluginTypes": ["F1", "F3"],
  "facts": {
    "modelVisible": true,
    "registersTools": false,
    "filesystem": "write",
    "persistentState": true,
    "subprocess": true,
    "subagents": false,
    "temporaryResources": true,
    "customProtocol": true
  },
  "package": {
    "path": "packages/dsh/package.json"
  },
  "tests": {
    "contractTests": [],
    "runtimeTests": [
      {
        "file": "packages/dsh/tests/engine.spec.ts",
        "layer": "L2"
      },
      {
        "file": "packages/dsh/tests/session-surface.spec.ts",
        "layer": "L2"
      },
      {
        "file": "packages/dsh/tests/code-handler.spec.ts",
        "layer": "L2"
      },
      {
        "file": "packages/dsh/tests/session-adapter.spec.ts",
        "layer": "L0"
      },
      {
        "file": "packages/dsh/tests/model-readiness.spec.ts",
        "layer": "L0"
      },
      {
        "file": "packages/dsh/tests/session-admission.spec.ts",
        "layer": "L1"
      },
      {
        "file": "packages/dsh/tests/session-admission-agent-loop.spec.ts",
        "layer": "L2"
      },
      {
        "file": "packages/dsh/tests/host.spec.ts",
        "layer": "L1"
      },
      {
        "file": "packages/dsh/tests/eval-suite.spec.ts",
        "layer": "L1"
      }
    ]
  },
  "config": {
    "file": "packages/dsh/src/config.ts",
    "schemaExport": "CONFIG_SCHEMA",
    "rootField": "root",
    "assembly": {
      "file": "packages/dsh/src/service.ts"
    }
  },
  "errors": {
    "file": "packages/core/src/error.ts",
    "export": "WorkSurfaceError",
    "requiredFields": [
      "code",
      "message",
      "details"
    ]
  },
  "cli": {
    "entrypoint": "packages/cli/src/bin.ts"
  },
  "contracts": [
    {
      "name": "worksurface-host-rpc",
      "file": "packages/dsh/spec/host-rpc.json",
      "versionField": "version"
    }
  ]
}
